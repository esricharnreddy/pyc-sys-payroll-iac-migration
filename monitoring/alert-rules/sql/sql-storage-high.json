{
  "name": "sql-storage-high",
  "type": "Microsoft.Insights/metricAlerts",
  "location": "Global",
  "tags": { "Environment": "UAT", "Application": "DBMigration", "CostCenter": "IT" },
  "properties": {
    "displayName": "Storage Consumption - SQL DB",
    "description": "Alerts when SQL Database storage exceeds 80%",
    "severity": 2,
    "enabled": true,
    "evaluationFrequency": "PT15M",
    "windowSize": "PT15M",
    "scopes": [
      "/subscriptions/e81f0045-b703-4020-8964-66028e11004c/resourceGroups/PAY-UAT-EUS2-APP-RG/providers/Microsoft.Sql/servers/sql-uat-app/databases/FinanceDB",
      "/subscriptions/e81f0045-b703-4020-8964-66028e11004c/resourceGroups/PAY-UAT-EUS2-APP-RG/providers/Microsoft.Sql/servers/sql-uat-app/databases/HRDB",
      "/subscriptions/e81f0045-b703-4020-8964-66028e11004c/resourceGroups/PAY-UAT-EUS2-APP-RG/providers/Microsoft.Sql/servers/sql-uat-app/databases/SalesDB",
      "/subscriptions/e81f0045-b703-4020-8964-66028e11004c/resourceGroups/PAY-UAT-EUS2-APP-RG/providers/Microsoft.Sql/servers/sql-uat-app/databases/InventoryDB"
    ],
    "criteria": {
      "allOf": [
        {
          "metricName": "storage_percent",
          "operator": "GreaterThan",
          "threshold": 80,
          "timeAggregation": "Maximum"
        }
      ]
    },
    "actions": [
      {
        "actionGroupId": "/subscriptions/e81f0045-b703-4020-8964-66028e11004c/resourceGroups/PMI-PRD-WUS2-MIG-RG/providers/Microsoft.Insights/actionGroups/migration-alerts-ag"
      }
    ]
  }
}

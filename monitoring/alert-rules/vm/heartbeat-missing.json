{
  "name": "heartbeat-missing",
  "type": "Microsoft.Insights/scheduledQueryRules",
  "location": "westus2",
  "tags": { "Environment": "UAT", "Application": "DBMigration", "CostCenter": "IT" },
  "properties": {
    "displayName": "VM Heartbeat Missing",
    "description": "Alerts when no heartbeat received from VM for 5 minutes",
    "severity": 1,
    "enabled": true,
    "evaluationFrequency": "PT5M",
    "windowSize": "PT5M",
    "scopes": [
      "/subscriptions/e81f0045-b703-4020-8964-66028e11004c/resourceGroups/PMI-PRD-WUS2-MIG-RG/providers/Microsoft.OperationalInsights/workspaces/PMI-PRD-WUS2-LAW"
    ],
    "criteria": {
      "allOf": [
        {
          "query": "Heartbeat | summarize LastHeartbeat = max(TimeGenerated) by Computer | where LastHeartbeat < ago(5m)",
          "timeAggregation": "Count",
          "operator": "GreaterThan",
          "threshold": 0
        }
      ]
    },
    "actions": {
      "actionGroups": [
        "/subscriptions/e81f0045-b703-4020-8964-66028e11004c/resourceGroups/PMI-PRD-WUS2-MIG-RG/providers/Microsoft.Insights/actionGroups/migration-alerts-ag"
      ]
    }
  }
}

{
  "name": "deny-public-ip-creation",
  "properties": {
    "displayName": "Deny creation of Public IP addresses",
    "description": "Blocks creation of public IP addresses to enforce network security",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Custom"
    },
    "parameters": {},
    "policyRule": {
      "if": {
        "field": "type",
        "equals": "Microsoft.Network/publicIPAddresses"
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}
